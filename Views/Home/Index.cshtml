@{
    ViewData["Title"] = "Chat";
}
<div class="app" id="app" data-hub-url="@Url.Content("~/chathub")" data-config-url="@Url.Action("CallConfiguration", "Home")">
    <aside class="sidebar" id="sidebar" aria-label="Conversations">
        <div class="brand"><span class="brand-icon">t</span><div>Together<span class="eyebrow">A little closer, from anywhere.</span></div></div>
        <div class="profile"><span class="avatar" id="myAvatar">?</span><div><strong id="myName">Your space to connect</strong><small id="connectionStatus" role="status">Join to get started</small></div><button id="themeButton" class="icon-button" aria-label="Toggle dark theme" title="Toggle theme">◐</button></div>
        <label class="search"><span aria-hidden="true">⌕</span><input id="searchUsers" type="search" placeholder="Find a person…" aria-label="Search people" /></label>
        <div class="section-label">CONVERSATIONS <span id="onlineCount">0 online</span></div>
        <nav id="conversationList" aria-label="Select conversation"></nav>
        <div class="sidebar-note"><span class="live-dot"></span> Made for in-the-moment conversations.<br /><small>History stays in this tab until you leave.</small></div>
    </aside>
    <main class="chat">
        <header class="chat-header"><button id="peopleButton" class="icon-button mobile-only" aria-label="Open conversations" aria-expanded="false">☰</button><span class="avatar room-avatar" id="chatAvatar">#</span><div class="chat-heading"><h1 id="chatTitle">Everyone</h1><p id="chatSubtitle">The shared room · say hello to everyone</p></div><div class="call-actions"><button id="voiceButton" title="Select a person to call" disabled>☎ <span>Voice</span></button><button id="videoButton" title="Select a person to call" disabled>▣ <span>Video</span></button></div></header>
        <div class="room-banner" id="roomBanner">A shared space for the whole group. Pick someone on the left for a private conversation.</div>
        <div id="messages" class="messages" role="log" aria-label="Chat messages" aria-live="polite"></div>
        <div id="notice" class="notice" role="status" hidden></div>
        <form id="messageForm" class="composer">
            <div id="attachmentPreview" class="attachment-preview" hidden><span id="attachmentName"></span><button type="button" id="removeAttachment" aria-label="Remove attachment">×</button></div>
            <div class="composer-row"><button type="button" id="attachButton" class="icon-button" title="Attach a file (up to 2 MB)" aria-label="Attach file" disabled>＋</button><input type="file" id="fileInput" hidden /><textarea id="messageInput" rows="1" maxlength="4000" placeholder="Write a message…" aria-label="Message" disabled></textarea><button type="submit" id="sendButton" class="primary" disabled>Send <span aria-hidden="true">↗</span></button></div>
            <div class="composer-hint">Enter to send · Shift + Enter for a new line <span>Files up to 2 MB</span></div>
        </form>
    </main>
</div>
<dialog id="joinDialog" aria-labelledby="joinTitle"><form id="joinForm"><span class="brand-icon">t</span><p class="eyebrow">WELCOME TO TOGETHER</p><h2 id="joinTitle">Good conversations<br />start with a hello.</h2><p>Choose a name so everyone knows it's you.</p><label for="nameInput">Your name</label><input id="nameInput" minlength="2" maxlength="30" required autocomplete="nickname" placeholder="e.g. Vikas" /><p id="joinError" class="error" role="alert"></p><button id="joinButton" class="primary" type="submit">Join the conversation ↗</button><small>No account needed. Names aren't verified.</small></form></dialog>
<dialog id="callDialog" aria-labelledby="callTitle"><div class="call-content"><p class="eyebrow" id="callKind">VOICE CALL</p><h2 id="callTitle"></h2><p id="callStatus" role="status">Calling…</p><div id="videoStage" class="video-stage"><video id="remoteVideo" autoplay playsinline></video><video id="localVideo" autoplay playsinline muted></video></div><div class="call-controls"><button id="acceptCall" class="primary" hidden>Accept</button><button id="muteButton" hidden>Mute mic</button><button id="cameraButton" hidden>Camera off</button><button id="hangupButton" class="danger">End call</button></div></div></dialog>
@section Scripts {
    <script src="~/lib/signalr/signalr.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
}

