@model WebApplication2.Controllers.Credentials
@{ ViewData["Title"] = "Create account"; }
<main class="auth-page"><form asp-action="Register" method="post" class="auth-card"><span class="brand-icon">t</span><h1>Create your account</h1><p>Use at least 10 characters with upper and lower case letters and a number.</p><div asp-validation-summary="All" class="error" role="alert"></div><input asp-for="ReturnUrl" type="hidden" /><label asp-for="DisplayName">Your name</label><input asp-for="DisplayName" autocomplete="name" required minlength="2" maxlength="60" /><label asp-for="Username">Username</label><input asp-for="Username" autocomplete="username" required pattern="[a-zA-Z0-9_.-]{3,40}" maxlength="40" /><label asp-for="Password">Password</label><input asp-for="Password" type="password" autocomplete="new-password" required minlength="10" maxlength="128" /><button class="primary">Create account</button><a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Already have an account?</a></form></main>
